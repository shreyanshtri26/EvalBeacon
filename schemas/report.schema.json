{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evalbeacon.vercel.app/schemas/report.schema.json",
  "title": "EvalBeacon report contract",
  "description": "Schema for results/report.json (and the per-run files). schema_version follows semver: additive fields are a minor bump and readers must ignore unknown fields; removing or retyping a field is a major bump. Unknown values are null, never 0.",
  "type": "object",
  "$ref": "#/$defs/report",
  "$defs": {
    "nullableNumber": { "type": ["number", "null"] },
    "nullableInt": { "type": ["integer", "null"] },
    "nullableString": { "type": ["string", "null"] },
    "stringList": { "type": "array", "items": { "type": "string" } },

    "summary": {
      "type": "object",
      "required": ["cases", "passed", "errors", "pass_rate", "error_rate", "latency_p50_ms", "latency_p95_ms", "latency_mean_ms",
                   "tokens_in", "tokens_out", "total_cost_usd", "cost_per_success_usd", "cost_known_cases", "judged_cases", "judge_cost_usd"],
      "properties": {
        "cases": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "pass_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "error_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "latency_p50_ms": { "$ref": "#/$defs/nullableNumber" },
        "latency_p95_ms": { "$ref": "#/$defs/nullableNumber" },
        "latency_mean_ms": { "$ref": "#/$defs/nullableNumber" },
        "tokens_in": { "type": "integer", "minimum": 0, "description": "Sum over cases that reported usage; unknown cases contribute 0 here, see cost_known_cases." },
        "tokens_out": { "type": "integer", "minimum": 0 },
        "total_cost_usd": { "type": ["number", "null"], "minimum": 0, "description": "null when no case reported usage." },
        "cost_per_success_usd": { "type": ["number", "null"], "minimum": 0, "description": "null when there are no successes or no cost data." },
        "cost_known_cases": { "type": "integer", "minimum": 0 },
        "judged_cases": { "type": "integer", "minimum": 0 },
        "judge_cost_usd": { "type": "number", "minimum": 0 }
      }
    },

    "judge": {
      "type": "object",
      "required": ["score", "min_score", "passed", "rationale", "judge_model", "judge_version", "uncertainty"],
      "properties": {
        "score": { "type": "integer", "minimum": 1, "maximum": 5 },
        "min_score": { "type": "number" },
        "passed": { "type": "boolean" },
        "rationale": { "type": "string" },
        "judge_model": { "type": "string" },
        "judge_version": { "type": "string" },
        "cost_usd": { "$ref": "#/$defs/nullableNumber" },
        "uncertainty": { "type": "string" }
      }
    },

    "result": {
      "type": "object",
      "required": ["id", "status", "reasons", "latency_ms", "trace_id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/nullableString" },
        "status": { "enum": ["pass", "fail", "error"], "description": "fail = a check did not hold; error = the agent/provider/runner failed (not a quality verdict)." },
        "reasons": { "$ref": "#/$defs/stringList" },
        "output": { "$ref": "#/$defs/nullableString", "description": "Redacted and truncated; null when output capture is disabled or the case errored." },
        "expected_error": { "type": "boolean" },
        "trace_id": { "type": ["string", "null"], "pattern": "^[0-9a-f]{32}$", "description": "32 hex chars; null when no tracer provider was installed." },
        "tokens_in": { "$ref": "#/$defs/nullableInt" },
        "tokens_out": { "$ref": "#/$defs/nullableInt" },
        "cost_usd": { "type": ["number", "null"], "minimum": 0, "description": "null = unknown, never 0." },
        "cost_basis": { "type": "string" },
        "latency_ms": { "type": "number", "minimum": 0 },
        "judge": { "$ref": "#/$defs/judge" },
        "payload_ref": { "$ref": "#/$defs/nullableString" },
        "store_error": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "pass" } } }, "then": { "properties": { "reasons": { "maxItems": 0 } } } },
        { "if": { "properties": { "status": { "enum": ["fail", "error"] } } }, "then": { "properties": { "reasons": { "minItems": 1 } } } }
      ]
    },

    "run": {
      "type": "object",
      "required": ["schema_version", "run_id", "name", "model", "dataset_version", "evaluator_version", "started_at", "finished_at",
                   "status", "failure_summary", "config", "isolation", "results", "summary"],
      "properties": {
        "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
        "run_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "model": { "type": "string" },
        "dataset_version": { "type": "string", "pattern": "^sha256:[0-9a-f]{12}$" },
        "evaluator_version": { "type": "string" },
        "started_at": { "type": "number" },
        "finished_at": { "type": "number" },
        "status": { "enum": ["complete", "partial", "failed"], "description": "complete: no errors; partial: some cases errored; failed: every case errored." },
        "failure_summary": {
          "type": "array",
          "items": { "type": "object", "required": ["id", "reason"], "properties": { "id": { "type": "string" }, "reason": { "type": "string" } } }
        },
        "config": {
          "type": "object",
          "required": ["model", "revision", "dataset_version", "evaluator_version", "pricing_version"],
          "properties": {
            "model": { "type": "string" }, "revision": { "type": "string" }, "dataset_version": { "type": "string" },
            "evaluator_version": { "type": "string" }, "pricing_version": { "type": "string" }
          }
        },
        "isolation": {
          "type": "object",
          "required": ["mode", "timed_out_cases", "still_running"],
          "properties": {
            "mode": { "enum": ["thread", "process"] },
            "timed_out_cases": { "type": "integer", "minimum": 0 },
            "still_running": { "type": "integer", "minimum": 0, "description": "Timed-out agent threads of this run still alive when it returned; threads cannot be killed." }
          }
        },
        "results": { "type": "array", "items": { "$ref": "#/$defs/result" } },
        "summary": { "$ref": "#/$defs/summary" }
      }
    },

    "gate": {
      "type": "object",
      "required": ["schema_version", "decision", "exit_code", "reasons", "regressions", "fixes", "policy", "baseline", "candidate",
                   "baseline_name", "candidate_name", "dataset_version"],
      "properties": {
        "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
        "decision": { "enum": ["pass", "fail", "error", "inconclusive"] },
        "exit_code": { "enum": [0, 1, 2, 3] },
        "reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["gate", "detail", "cases"],
            "properties": { "gate": { "type": "string" }, "detail": { "type": "string" }, "cases": { "$ref": "#/$defs/stringList" } }
          }
        },
        "regressions": { "$ref": "#/$defs/stringList" },
        "fixes": { "$ref": "#/$defs/stringList" },
        "policy": { "type": "object", "additionalProperties": { "type": "number" } },
        "baseline": { "$ref": "#/$defs/summary" },
        "candidate": { "$ref": "#/$defs/summary" },
        "baseline_name": { "type": "string" },
        "candidate_name": { "type": "string" },
        "dataset_version": { "type": "string" },
        "notes": { "$ref": "#/$defs/stringList" }
      },
      "allOf": [
        { "if": { "properties": { "decision": { "const": "pass" } } }, "then": { "properties": { "exit_code": { "const": 0 }, "reasons": { "maxItems": 0 } } } },
        { "if": { "properties": { "decision": { "const": "fail" } } }, "then": { "properties": { "exit_code": { "const": 1 }, "reasons": { "minItems": 1 } } } },
        { "if": { "properties": { "decision": { "const": "error" } } }, "then": { "properties": { "exit_code": { "const": 2 }, "reasons": { "minItems": 1 } } } },
        { "if": { "properties": { "decision": { "const": "inconclusive" } } }, "then": { "properties": { "exit_code": { "const": 3 } } } }
      ]
    },

    "report": {
      "type": "object",
      "required": ["schema_version", "baseline", "candidate", "gate"],
      "properties": {
        "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
        "baseline": { "$ref": "#/$defs/run" },
        "candidate": { "$ref": "#/$defs/run" },
        "gate": { "$ref": "#/$defs/gate" }
      }
    },

    "drift": {
      "type": "object",
      "required": ["decision", "exit_code", "method", "threshold", "compared", "mean_similarity", "drifted_pct", "drifted",
                   "missing_in_current", "similarities", "golden_name", "dataset_version"],
      "properties": {
        "decision": { "enum": ["stable", "drift", "inconclusive"] },
        "exit_code": { "enum": [0, 1, 3] },
        "method": { "enum": ["lexical-cosine", "embedding"] },
        "threshold": { "type": "number" },
        "compared": { "type": "integer", "minimum": 0 },
        "mean_similarity": { "$ref": "#/$defs/nullableNumber" },
        "drifted_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "drifted": { "$ref": "#/$defs/stringList" },
        "missing_in_current": { "$ref": "#/$defs/stringList" },
        "similarities": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } },
        "golden_name": { "type": "string" },
        "dataset_version": { "type": "string" }
      }
    }
  }
}
