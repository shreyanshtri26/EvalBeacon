# Set only the keys for the providers you use. Never commit .env.
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# Host runs: http://localhost:4317. Docker Compose overrides this to the collector service.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=evalbeacon
ENVIRONMENT=development
